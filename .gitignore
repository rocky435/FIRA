# Environment files with secrets — cover every workspace, not just client.
# Keep .env.example templates tracked so new envs are self-documenting.
.env
.env.*
!.env.example
!*/.env.example
client/.env
server/.env
admin/.env
# Firebase service account keys (FCM) - never commit
*firebase-adminsdk*.json
firebase-service-account*.json
node_modules/
